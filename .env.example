# Mistral AI API Key
# Get yours at https://console.mistral.ai/api-keys/
# MISTRAL_API_KEY=your key
# Optional: Specify model (defaults to mistral-small-latest)
# MISTRAL_MODEL=mistral-small-latest

# ── Optional: Google Gemini API Key ──
# Enables real-time YouTube video search (replaces AI-generated video recommendations)
# Get yours at https://aistudio.google.com/apikey
# GOOGLE_GEMINI_API_KEY=AIzaSy...

# ── Optional: Google Books API Key ──
# Enables verified book metadata with stable, permanent Google Books URLs
# Get yours at https://console.cloud.google.com/apis/credentials (enable "Books API")
# Free tier: 1,000 requests/day — works without a key (rate-limited), but adding a key increases quotas
# GOOGLE_BOOKS_API_KEY=AIzaSy...